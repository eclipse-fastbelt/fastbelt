{
  "scopeName": "source.tokenmodes-common",
  "patterns": [],
  "repository": {
    "Model": {
      "patterns": [
        {
          "include": "#mode_default"
        }
      ]
    },
    "keywords_IN_INTERPOLATION": {
      "match": "(\\+)|(\\(|\\))",
      "captures": {
        "1": {
          "name": "keyword.operator.tokenmodes"
        },
        "2": {
          "name": "punctuation.section.tokenmodes"
        }
      }
    },
    "keywords_default": {
      "match": "(:=|\\+)|(\\(|\\))",
      "captures": {
        "1": {
          "name": "keyword.operator.tokenmodes"
        },
        "2": {
          "name": "punctuation.section.tokenmodes"
        }
      }
    },
    "mode_IN_INTERPOLATION": {
      "patterns": [
        {
          "include": "#token_Backtick_push_IN_STRING"
        },
        {
          "include": "#token_SL_COMMENT_comment"
        },
        {
          "include": "#token_ML_COMMENT_comment"
        },
        {
          "include": "#keywords_IN_INTERPOLATION"
        },
        {
          "include": "#token_ID"
        },
        {
          "include": "#token_INT"
        }
      ]
    },
    "mode_IN_STRING": {
      "patterns": [
        {
          "include": "#token_HashLeftBrace_push_IN_INTERPOLATION"
        },
        {
          "include": "#token_STRING_CONTENT"
        }
      ]
    },
    "mode_default": {
      "patterns": [
        {
          "include": "#token_Backtick_push_IN_STRING"
        },
        {
          "include": "#token_SL_COMMENT_comment"
        },
        {
          "include": "#token_ML_COMMENT_comment"
        },
        {
          "include": "#keywords_default"
        },
        {
          "include": "#token_ID"
        },
        {
          "include": "#token_INT"
        }
      ]
    },
    "token_Backtick_push_IN_STRING": {
      "begin": "`",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.tokenmodes"
        }
      },
      "end": "`",
      "endCaptures": {
        "0": {
          "name": "keyword.operator.tokenmodes"
        }
      },
      "patterns": [
        {
          "include": "#mode_IN_STRING"
        }
      ]
    },
    "token_HashLeftBrace_push_IN_INTERPOLATION": {
      "begin": "#\\{",
      "beginCaptures": {
        "0": {
          "name": "keyword.operator.tokenmodes"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.tokenmodes"
        }
      },
      "patterns": [
        {
          "include": "#mode_IN_INTERPOLATION"
        }
      ]
    },
    "token_ID": {
      "match": "[A-Z_a-z][0-9A-Z_a-z]*"
    },
    "token_INT": {
      "name": "constant.numeric.tokenmodes",
      "match": "[0-9]+"
    },
    "token_ML_COMMENT_comment": {
      "name": "comment.block.tokenmodes",
      "begin": "/\\*",
      "end": "\\*/"
    },
    "token_SL_COMMENT_comment": {
      "name": "comment.line.tokenmodes",
      "match": "//[^\\n\\r]*"
    },
    "token_STRING_CONTENT": {
      "name": "string.quoted.other.tokenmodes",
      "match": "([^#\\\\`]|\\\\[#\\\\`nrt])+"
    }
  }
}
