{
  "scopeName": "source.strings-common",
  "patterns": [],
  "repository": {
    "Model": {
      "patterns": [
        {
          "include": "#mode_default"
        }
      ]
    },
    "keywords_default": {
      "match": "(\\bconst\\b)|(\\blet!)|(\\blet\\b)|(:=)|(:)|(;)",
      "captures": {
        "1": {
          "name": "keyword.control.strings"
        },
        "2": {
          "name": "keyword.control.strings"
        },
        "3": {
          "name": "keyword.control.strings"
        },
        "4": {
          "name": "keyword.operator.strings"
        },
        "5": {
          "name": "punctuation.separator.strings"
        },
        "6": {
          "name": "punctuation.terminator.strings"
        }
      }
    },
    "mode_default": {
      "patterns": [
        {
          "include": "#token_STRING"
        },
        {
          "include": "#token_RAW_STRING"
        },
        {
          "include": "#token_CHAR"
        },
        {
          "include": "#token_DIRECTIVE_hidden"
        },
        {
          "include": "#token_COMMENT_comment"
        },
        {
          "include": "#keywords_default"
        },
        {
          "include": "#token_ID"
        },
        {
          "include": "#token_NUMBER"
        }
      ]
    },
    "token_CHAR": {
      "name": "string.quoted.single.strings",
      "begin": "'",
      "end": "'"
    },
    "token_COMMENT_comment": {
      "patterns": [
        {
          "name": "comment.line.strings",
          "begin": "--",
          "end": "$"
        },
        {
          "name": "comment.block.strings",
          "begin": "\\{-",
          "end": "-\\}"
        }
      ]
    },
    "token_DIRECTIVE_hidden": {
      "match": "#[a-z]+"
    },
    "token_ID": {
      "name": "variable.other.strings",
      "match": "[A-Z_a-z][0-9A-Z_a-z]*"
    },
    "token_NUMBER": {
      "name": "constant.numeric.strings",
      "match": "[0-9]+(\\.[0-9]+)?"
    },
    "token_RAW_STRING": {
      "name": "string.quoted.backtick.strings",
      "begin": "`",
      "end": "`"
    },
    "token_STRING": {
      "name": "string.quoted.double.strings",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.strings",
          "match": "\\\\."
        }
      ]
    }
  }
}
